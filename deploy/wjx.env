# deploy/wjx.env — the configuration of the wjx.apflu.com instance (branch wjx-deploy), as an env file.
#
# Docker:   docker run -d --name stronghold -p 127.0.0.1:3100:3000 --restart unless-stopped \
#             --env-file deploy/wjx.env -v "$PWD/logs:/app/logs" stronghold-protocol:latest
# npm:      set -a; . deploy/wjx.env; set +a; npm start
# (docker --env-file takes every line literally: no quotes, no spaces around "=".)
#
# Every variable is documented in README.md. Unset = the official behaviour.

# ---- AI teammates -------------------------------------------------------------------------------------------------
# quiet help for AI teammates in co-op 绝境 / 终极 (extra coins, better rolls of what they merge, no stat changes)
SP_BOT_ASSIST=1
# every AI pushes this bond to its top tier (坚守)
SP_BOT_PREFER_BOND=steadShip
# an AI seat takes this strategy in the draft while it is free (阿米娅)
SP_BOT_PREFER_BAND=band_amiya
# 联防 helpers: humans first (a bounty enemy's coins go to the helper), AI only for the seats left
SP_BOT_HELP_LAST=1

# ---- difficulty and economy -------------------------------------------------------------------------------------
# leader HP pool (Final Assault / Hidden Core): upstream 0.2.0's own base (data HP × players alive), no host multiplier
#SP_BOSS_HP_MUL_SOLO=1
#SP_BOSS_HP_MUL_COOP=1
# 碎骨·悬赏 pays 3 coins instead of 1
SP_BOUNTY_COINS=enemyeffect_b_1=3
# the per-player 轮回之终末 box in rooms (+4 coins a round; no bond at 999 when R14's prep ends = eliminated)
SP_BOOST=1
# special-enemy groups a round never draws, comma separated: the 萨卡兹穿刺手 group (players found it unfair)
SP_FACTION_EXCLUDE=enemy_1072_dlancer
# 联防 on the round's own map (water, crates, devices), as up to 0.1.4 — tournament footage (GitHub #244) shows it so
SP_UNITE_ROUND_MAP=1

# ---- client-side combat -------------------------------------------------------------------------------------------
# re-simulate every client-reported battle on the server; the server's result wins when they differ (a player's
# browser once reported 炎 without 炎佑 and everything leaked, 2026-10-09; mismatches go to the event log as `verify`)
SP_VERIFY=all

# ---- our own instance only (kept for reference, off here) -------------------------------------------------------
# extra coins per round in solo, for the listed nicknames only (practice)
#SP_BONUS_FUNDS=3
#SP_BONUS_FUNDS_FOR=sjfy
# invite-only room creation: anyone joins, only invited devices create rooms (tools/access.mjs manages invites);
# the note guests see
#SP_ACCESS=host
#SP_ACCESS_MESSAGE=私有实例，仅限受邀玩家创建房间。

# ---- event log --------------------------------------------------------------------------------------------------
# one events-<date>.jsonl per day (rooms, every action, every battle's parameters and result); node tools/logs.mjs
# (Docker path; with npm start use e.g. ./logs)
SP_LOG_DIR=/app/logs
